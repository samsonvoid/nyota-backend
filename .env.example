# Supabase (Cloud Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# DB Connection (for local tools like migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Local PostgreSQL (Hybrid Architecture - Offline Memory)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=nyota_local
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your-local-postgres-password

# Supabase Management API Token (generate from https://app.supabase.com/account/tokens)
SUPABASE_MGMT_TOKEN=sbp_your_management_token

# Internal API key for frontend-backend communication
API_SECRET_KEY=change-this-to-a-random-secret

# Comma-separated project folders Nyota may inspect, for example:
# NYOTA_ALLOWED_WORKSPACES=F:\\Project\\Nyota Assistant,F:\\Project\\Other App
NYOTA_ALLOWED_WORKSPACES=

# Optional local memory and audit locations
NYOTA_MEMORY_FILE=
NYOTA_AUDIT_LOG=
NYOTA_APPROVAL_AUDIT_LOG=

# Hybrid Memory Sync Settings
SYNC_ENABLED=true

# Google AI
GEMINI_API_KEY=your-gemini-api-key
